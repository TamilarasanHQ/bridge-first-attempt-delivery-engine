# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables & secrets
.env
.env.*
!.env.example

# IDE & Editor settings
.ipynb_checkpoints/
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Testing & Cache
.pytest_cache/
.coverage
htmlcov/

# Logs and runtime traces
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Datasets (never commit large raw or processed datasets to public repo)
data/raw/*
data/processed/*
!data/processed/.gitkeep
data/v2/*.parquet
data/v2/*.csv
!data/v2/.gitkeep
v1/data/*
v2/data/*
*_predictions.csv

# Models & Serialized Weights (never commit large serialized artifacts to git)
models/*
!models/.gitkeep
v1/models/*
!v1/models/.gitkeep
!v1/models/risk_policy_v1.json
v2/models/*
!v2/models/.gitkeep

# Binary formats
*.pkl
*.joblib
*.h5
*.npy
*.parquet

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
